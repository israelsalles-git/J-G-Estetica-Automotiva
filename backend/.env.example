# Copie este arquivo para .env e ajuste os valores
APP_NAME="J&G Estética Automotiva API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
# Supabase: cole a string de Connect > Session pooler (porta 5432) trocando [YOUR-PASSWORD] pela senha.
# Ex.: postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jg_estetica
# Token para rotas protegidas (POST/PUT/DELETE). Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Fuso dos agendamentos (datas enviadas sem fuso são interpretadas nele)
TIMEZONE=America/Sao_Paulo
# Google Agenda (opcional). Deixe vazio para desligar a integração.
# 1. Instale as dependências: pip install -e ".[google]"
# 2. Crie uma conta de serviço no Google Cloud, ative a Google Calendar API e baixe a chave JSON.
# 3. Compartilhe a agenda com o e-mail da conta de serviço ("Fazer alterações nos eventos").
# 4. Preencha o ID da agenda (Configurações da agenda > Integrar agenda) e o caminho da chave.
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_FILE=
