# Copie este arquivo para .env e ajuste os valores
APP_NAME="Tal Da Estetica Automotiva API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
# Supabase: cole a string de Connect > Session pooler (porta 5432) trocando [YOUR-PASSWORD] pela senha.
# Ex.: postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jg_estetica
# Segredo que assina os tokens de login (JWT). Use pelo menos 32 caracteres.
# Vazio = ninguém consegue logar (o login responde 503). Com ENVIRONMENT=production, a API nem sobe.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Validade do token em minutos (480 = 8 horas). Depois disso, é preciso logar de novo.
JWT_EXPIRA_MIN=480
# CORS: sites que podem chamar a API pelo navegador (o site Flutter Web roda em outra origem).
# Desenvolvimento: libera qualquer porta do localhost (o "flutter run -d chrome" muda de porta a cada execução).
CORS_ORIGIN_REGEX=http://localhost:\d+
# Produção: endereços exatos do site, em formato JSON e sem "/" no final.
# Ex.: CORS_ORIGINS=["https://seusite.com.br","https://www.seusite.com.br"]
# Atenção: não deixe "CORS_ORIGINS=" vazio (a API não sobe). Use [] ou apague a linha.
CORS_ORIGINS=[]
# Fuso dos agendamentos (datas enviadas sem fuso são interpretadas nele)
TIMEZONE=America/Sao_Paulo
# Google Agenda (opcional). Deixe vazio para desligar a integração.
# 1. Instale as dependências: pip install -e ".[google]"
# 2. Crie uma conta de serviço no Google Cloud, ative a Google Calendar API e baixe a chave JSON.
# 3. Compartilhe a agenda com o e-mail da conta de serviço ("Fazer alterações nos eventos").
# 4. Preencha o ID da agenda (Configurações da agenda > Integrar agenda) e o caminho da chave.
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_FILE=

# Login do painel com Google (opcional). Client ID do cliente OAuth tipo Web application.
# Não precisa do extra [google]: google-auth e requests já vêm nas dependências principais.
# Só entram as contas da lista fixa (JSON), e o e-mail precisa existir como admin ativo.
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAILS=[]
